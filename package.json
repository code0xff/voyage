{
  "name": "voyage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "polar": "tsx scripts/polar.ts",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.4",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "description": "Sailing simulator with real aerodynamics, hydrodynamics and wave physics, in the browser.",
  "license": "MIT"
}
